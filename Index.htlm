<!DOCTYPE html>
<html lang="it">
<head>

<meta charset="UTF-8">
<meta name="viewport"
content="width=device-width, initial-scale=1">

<title>🌱 Piante</title>

<link
rel="stylesheet"
href="style.css">

</head>

<body>

<header>

<h1>🌱 Piante</h1>

<p>
Gestione delle tue piante
</p>

</header>

<div class="container">

<div class="card">

<h2>➕ Aggiungi Pianta</h2>

<input
id="name"
placeholder="Nome pianta">

<select id="category">

<option>Vaso</option>

<option>Terreno</option>

</select>

<input
id="purchase"
type="date">

<input
id="frequency"
type="number"
placeholder="Frequenza irrigazione">

<textarea
id="description"
placeholder="Descrizione">
</textarea>

<button
class="primary"
onclick="addPlant()">

Aggiungi

</button>

</div>

<div id="plantList"></div>

</div>

<script src="app.js"></script>

</body>
</html>
